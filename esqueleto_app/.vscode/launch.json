{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Programa con PYTHONPATH=${workspaceFolder}",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
